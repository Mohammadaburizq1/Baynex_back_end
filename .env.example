# Copy to email.env and set MAIL_PASSWORD (Gmail App Password, not your login password)
# Edit: shoplink_backend/email.env  (visible in file explorer)

MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=info@khangates.com
MAIL_PASSWORD=your-gmail-app-password-here
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=info@khangates.com
MAIL_FROM_NAME=khanGates
FRONTEND_BASE_URL=http://localhost:8080

# Local testing without Gmail — use Mailpit instead:
# MAIL_HOST=mailpit
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false
# MAIL_FROM=noreply@shoplink.local
# UI: http://localhost:8025
